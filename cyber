class WebInterface:
    """
    Simple web interface for the security suite
    Runs locally with Flask
    """
    
    def __init__(self, suite: DeepfakeSecuritySuite):
        self.suite = suite
        self.app = None
        
    def run(self, host: str = 'localhost', port: int = 5000):
        """Start the web interface"""
        try:
            from flask import Flask, render_template, request, jsonify
        except ImportError:
            print("❌ Flask not installed. Run: pip install flask")
            return
        
        self.app = Flask(__name__)
        
        @self.app.route('/')
        def index():
            return '''
            <!DOCTYPE html>
            <html>
            <head>
                <title>Deepfake Security Suite</title>
                <style>
                    body { font-family: Arial; margin: 40px; background: #f0f0f0; }
                    .container { max-width: 800px; margin: auto; background: white; padding: 20px; border-radius: 10px; }
                    h1 { color: #333; }
                    .upload-box { border: 2px dashed #ccc; padding: 20px; text-align: center; margin: 20px 0; }
                    button { background: #4CAF50; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; }
                    #result { margin-top: 20px; padding: 10px; border-radius: 5px; }
                    .fake { background: #ffebee; color: #c62828; }
                    .real { background: #e8f5e8; color: #2e7d32; }
                </style>
            </head>
            <body>
                <div class="container">
                    <h1>🛡️ Deepfake Security Suite</h1>
                    <p>Upload a file to analyze for deepfakes</p>
                    
                    <div class="upload-box">
                        <input type="file" id="fileInput">
                        <br><br>
                        <button onclick="analyzeFile()">Analyze File</button>
                    </div>
                    
                    <div id="result"></div>
                </div>
                
                <script>
                    async function analyzeFile() {
                        const fileInput = document.getElementById('fileInput');
                        const file = fileInput.files[0];
                        
                        if (!file) {
                            alert('Please select a file');
                            return;
                        }
                        
                        const formData = new FormData();
                        formData.append('file', file);
                        
                        document.getElementById('result').innerHTML = 'Analyzing...';
                        
                        try {
                            const response = await fetch('/analyze', {
                                method: 'POST',
                                body: formData
                            });
                            
                            const result = await response.json();
                            
                            let html = '<h3>Analysis Results:</h3>';
                            html += `<p>File Type: ${result.file_type}</p>`;
                            html += `<p>Is Deepfake: ${result.is_deepfake ? '🚨 YES' : '✅ NO'}</p>`;
                            html += `<p>Confidence: ${(result.confidence * 100).toFixed(2)}%</p>`;
                            html += `<p>Risk Level: ${result.risk_level}</p>`;
                            
                            if (result.indicators && result.indicators.length) {
                                html += '<p>Indicators:</p><ul>';
                                result.indicators.forEach(i => html += `<li>${i}</li>`);
                                html += '</ul>';
                            }
                            
                            document.getElementById('result').className = result.is_deepfake ? 'fake' : 'real';
                            document.getElementById('result').innerHTML = html;
                            
                        } catch (error) {
                            document.getElementById('result').innerHTML = 'Error: ' + error;
                        }
                    }
                </script>
            </body>
            </html>
            '''
        
        @self.app.route('/analyze', methods=['POST'])
        def analyze():
            file = request.files['file']
            file_path = f"uploads/{file.filename}"
            file.save(file_path)
            
            result = self.suite.analyze_file(file_path)
            
            # Clean up
            try:
                os.remove(file_path)
            except:
                pass
            
            return jsonify(self.suite.result_to_dict(result))
        
        print(f"🌐 Starting web interface at http://{host}:{port}")
        print("Press Ctrl+C to stop")
        self.app.run(host=host, port=port, debug=False)


